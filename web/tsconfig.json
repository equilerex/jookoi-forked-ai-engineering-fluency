{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "../desktop/node_modules/@types",
      "../vscode-extension/node_modules/@types"
    ],
    "paths": {
      "chalk": ["./node_modules/chalk/source/index.d.ts"],
      "@msgpack/msgpack": ["../desktop/node_modules/@msgpack/msgpack/dist.esm/index.d.ts", "./node_modules/@msgpack/msgpack/dist.esm/index.d.ts"],
      "sql.js": ["../vscode-extension/node_modules/@types/sql.js/index.d.ts", "./node_modules/@types/sql.js/index.d.ts"]
    },
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
